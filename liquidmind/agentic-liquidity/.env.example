# CRE Agentic Liquidity Workflow
# Copy to .env and fill in your values

# RPC used by runtime market-data reads and the shared HTTP workflow path.
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Optional local wallet for manual contract-side scripts or submission bridges.
# Not required for `npm run validate:real`.
# PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional CRE wallet/auth variable.
# Leave unset for the current `cre workflow simulate` flow unless you
# intentionally need wallet-authenticated CRE operations.
# CRE_ETH_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
