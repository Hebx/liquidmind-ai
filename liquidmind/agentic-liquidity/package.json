{
  "name": "@liquidmind-ai/agentic-liquidity",
  "version": "1.0.0",
  "description": "Canonical LiquidMind CRE package for Chainlink reads, volatility analysis, and Base Sepolia action preparation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "cre-compile": "bunx cre-compile ./main.ts .cre_build_tmp.wasm",
    "validate:real": "npm run cre-compile",
    "postinstall": "bunx cre-setup",
    "dev": "tsx src/agentic-liquidity.ts",
    "simulate": "npm run simulate:mock",
    "simulate:mock": "tsx src/mock-workflow.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "chainlink",
    "cre",
    "workflow",
    "defi",
    "liquidity",
    "uniswap",
    "base-sepolia"
  ],
  "author": "Hebx",
  "license": "MIT",
  "dependencies": {
    "@chainlink/cre-sdk": "^1.1.1",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  }
}
