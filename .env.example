# LIQUIDMIND Environment Variables
# Copy to .env and fill in your values

# Base Sepolia RPC
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployer / Agent private key
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Deployed contract addresses
LIQUIDMIND_HOOK_ADDRESS=0xC28ed0595D42ec01A2F7546f39Cf27Ea798598C0
LIQUIDMIND_COORDINATOR_ADDRESS=0x268c2E3D23f5cDDAA0D0B40142053414cC05991b

# CRE (for workflow deploy — simulation doesn't need these)
CRE_ETH_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
