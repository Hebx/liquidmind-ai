# LIQUIDMIND Environment Variables
# Copy to .env and fill in your values

# Base Sepolia RPC
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Contract deployer key.
# This is not automatically the same thing as `AGENT_PRIVATE_KEY` for `e2e-live.sh`;
# the agent wallet must also be registered on-chain in `LiquidMindCoordinator`.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Deployed contract addresses
LIQUIDMIND_HOOK_ADDRESS=0xb08542f31D6C765F30365148ee5E906F941d18C0
LIQUIDMIND_COORDINATOR_ADDRESS=0x68F321d6d33b23bAFC03CC4d84b1dBbe7cBFd063

# CRE note:
# - `npm run validate:cre` runs a real CRE simulation, not a workflow deploy.
# - Leave placeholder CRE gateway/workflow globals out of your shell; they can override browser auth.
# - CRE workflow deploy/activate currently also needs `ETH_MAINNET_RPC` plus deploy access on your CRE org.
# - If you set `CRE_ETH_PRIVATE_KEY`, prefer raw 64-hex without the `0x` prefix for the current CLI.
# CRE_ETH_PRIVATE_KEY=YOUR_PRIVATE_KEY_WITHOUT_0X
