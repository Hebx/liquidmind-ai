# Environment Variables for LIQUIDMIND

# Blockchain RPC URLs
BASE_SEPOLIA_RPC=https://sepolia.base.org
OPTIMISM_SEPOLIA_RPC=https://sepolia.optimism.io
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ETHEREUM_SEPOLIA_RPC=https://rpc.sepolia.org

# Private Keys (DO NOT COMMIT - use .env.local)
PRIVATE_KEY=your_private_key_here

# Chainlink CRE Configuration
CRE_WORKFLOW_ID=your_cre_workflow_id
CRE_GATEWAY_URL=https://your-cre-gateway.chain.link
CRE_API_KEY=your_cre_api_key

# x402 Configuration
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_NETWORK=base-sepolia
AGENT_TREASURY_ADDRESS=your_treasury_address

# A2A Agent Configuration
A2A_COORDINATOR_URL=http://localhost:3001
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Chainlink Price Feeds
CHAINLINK_PRICE_FEED_ETH_USD=0x...price_feed_address
CHAINLINK_CCIP_ROUTER=0x...ccip_router_address

# Uniswap v4
UNISWAP_V4_POOL_MANAGER=0x...pool_manager_address

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id