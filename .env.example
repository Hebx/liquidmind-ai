# LIQUIDMIND Environment Variables
# Copy to .env and fill in your values

# Base Sepolia RPC
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Contract deployer key.
# This is not automatically the same thing as `AGENT_PRIVATE_KEY` for `e2e-live.sh`;
# the agent wallet must also be registered on-chain in `LiquidMindCoordinator`.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Deployed contract addresses
LIQUIDMIND_HOOK_ADDRESS=0xC28ed0595D42ec01A2F7546f39Cf27Ea798598C0
LIQUIDMIND_COORDINATOR_ADDRESS=0x268c2E3D23f5cDDAA0D0B40142053414cC05991b

# CRE note:
# - `npm run validate:cre` is compile-only validation, not a workflow deploy.
# - Keep placeholder CRE gateway/workflow globals out of your shell.
# - Only set a CRE wallet key if you intentionally need wallet-authenticated CRE commands.
# CRE_ETH_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
