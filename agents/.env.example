# LIQUIDMIND Agent Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Agent Identity
# ============================================
AGENT_ID=liquidmind-coordinator
AGENT_PRIVATE_KEY=your_private_key_here

# ============================================
# Network Configuration
# ============================================
HEDERA_NETWORK=testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ============================================
# A2A Protocol
# ============================================
COORDINATOR_ENDPOINT=http://localhost:3001
AGENT_PORT=3002
WEBSOCKET_PORT=8080

# ============================================
# DEX API Endpoints
# ============================================
SAUCERSWAP_API=https://api.saucerswap.finance
PANNGOLIN_API=https://api.pangolin.exchange
HELI_SWAP_API=https://api.heliswap.io

# ============================================
# Agent Settings
# ============================================
REFRESH_INTERVAL_MS=30000
CACHE_DURATION_MS=60000
MIN_CONFIDENCE=0.85
MAX_SLIPPAGE=0.01
DEFAULT_DEADLINE_SECONDS=300

# ============================================
# Risk Analyzer Settings
# ============================================
RISK_ALERT_THRESHOLD=0.05
VOLATILITY_WINDOW_DAYS=30
MONITORING_INTERVAL_MS=60000

# ============================================
# Yield Aggregator Settings
# ============================================
YIELD_STALENESS_THRESHOLD_MS=300000
MIN_APY_THRESHOLD=0.01

# ============================================
# Google Vertex AI (for agent intelligence)
# ============================================
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-pro

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Security
# ============================================
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
