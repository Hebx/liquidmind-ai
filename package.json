{
  "name": "liquidmind-ai",
  "version": "0.1.0",
  "description": "LIQUIDMIND - Base Sepolia hook automation with live Chainlink reads and an HTTP-triggered CRE milestone in progress.",
  "private": true,
  "workspaces": [
    "contracts",
    "liquidmind/agentic-liquidity",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:contracts && npm run install:cre && npm run install:frontend",
    "install:contracts": "cd contracts && forge install",
    "install:cre": "cd liquidmind/agentic-liquidity && npm install",
    "install:frontend": "cd frontend && npm install",
    "test": "npm run test:contracts && npm run test:cre && npm run test:frontend",
    "test:contracts": "cd contracts && forge test",
    "test:cre": "cd liquidmind/agentic-liquidity && npm test",
    "test:frontend": "cd frontend && npm test",
    "build": "npm run build:cre && npm run build:frontend",
    "build:cre": "cd liquidmind/agentic-liquidity && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "deploy:testnet": "npm run deploy:contracts:testnet",
    "deploy:contracts:testnet": "cd contracts && forge script script/Deploy.s.sol:DeployLiquidMind --rpc-url $BASE_SEPOLIA_RPC --broadcast",
    "validate:cre": "cd liquidmind/agentic-liquidity && npm run validate:real",
    "simulate:cre": "cd liquidmind/agentic-liquidity && npm run simulate:mock",
    "compile:cre": "cd liquidmind/agentic-liquidity && npm run cre-compile",
    "deploy:cre:testnet": "node -e \"console.error('HTTP-triggered CRE deployment is the next milestone. From the repo root, use npm run validate:cre or npm run compile:cre for current validation.'); process.exit(1)\"",
    "lint": "npm run lint:contracts && npm run lint:ts",
    "lint:contracts": "cd contracts && forge fmt --check",
    "lint:ts": "eslint . --ext .ts,.tsx",
    "format": "npm run format:contracts && npm run format:ts",
    "format:contracts": "cd contracts && forge fmt",
    "format:ts": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hebx/liquidmind-ai.git"
  },
  "keywords": [
    "defi",
    "ai-agents",
    "chainlink",
    "cre",
    "uniswap-v4",
    "base-sepolia",
    "liquidity-management"
  ],
  "author": "Hebx",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.16.0"
  }
}
